{
  "id": "memory-kovamind",
  "kind": "memory",
  "contracts": {
    "tools": [
      "memory_recall",
      "memory_store",
      "memory_forget",
      "memory_surprise",
      "memory_reinforce",
      "vault_setup",
      "vault_unlock",
      "vault_lock",
      "vault_store",
      "vault_handles",
      "vault_find",
      "vault_execute"
    ]
  },
  "uiHints": {
    "apiKey": {
      "label": "Kova Mind API Key",
      "sensitive": true,
      "placeholder": "km_live_...",
      "help": "Your Kova Mind API key (or use ${KOVAMIND_API_KEY})"
    },
    "userId": {
      "label": "User ID",
      "placeholder": "axiom",
      "help": "Default user ID for memory operations"
    },
    "apiUrl": {
      "label": "API URL",
      "placeholder": "https://api.kovamind.io",
      "help": "Kova Mind API base URL",
      "advanced": true
    },
    "autoCapture": {
      "label": "Auto-Capture",
      "help": "Automatically extract memories from conversations"
    },
    "autoRecall": {
      "label": "Auto-Recall",
      "help": "Automatically inject relevant memories into context"
    },
    "maxRecallPatterns": {
      "label": "Max Recall Patterns",
      "placeholder": "5",
      "help": "Maximum memories to inject per turn",
      "advanced": true
    },
    "source": {
      "label": "Deployment Name",
      "placeholder": "spark",
      "help": "Which machine this gateway runs on. Stamped on stored memories and shown on recalled ones, so an agent can tell where a memory came from.",
      "advanced": true
    },
    "tokenBudget": {
      "label": "Token Budget",
      "placeholder": "2000",
      "help": "Token allowance for tiered recall, split across core/active/contextual/background. Ignored when the server has tiers disabled.",
      "advanced": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiKey": {
        "type": "string"
      },
      "userId": {
        "type": "string"
      },
      "apiUrl": {
        "type": "string",
        "default": "https://api.kovamind.io"
      },
      "autoCapture": {
        "type": "boolean",
        "default": true
      },
      "autoRecall": {
        "type": "boolean",
        "default": true
      },
      "maxRecallPatterns": {
        "type": "number",
        "minimum": 1,
        "maximum": 20,
        "default": 5
      },
      "source": {
        "type": "string",
        "maxLength": 64
      },
      "tokenBudget": {
        "type": "number",
        "minimum": 100,
        "maximum": 10000,
        "default": 2000
      }
    },
    "required": [
      "apiKey",
      "userId"
    ]
  }
}
